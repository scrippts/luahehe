--// STATE
local Enabled = false
local Busy = false
local SpinThread

--// CRAFT MACHINE MESSAGES
local Messages = {
	"Initializing Craft Machine...",
	"Analyzing spawn patterns...",
	"Manipulating spawn...",
	"Optimizing spawn selection...",
	"Searching best brainrot...",
	"Adjusting spawn priority...",
	"Crafting optimal spawn...",
	"Finalizing manipulation..."
}

--// SPINNER
local function StartSpinner()

	Spinner.Visible = true

	SpinThread = task.spawn(function()

		while Busy do
			Spinner.Rotation += 8
			task.wait(.02)
		end

		Spinner.Rotation = 0
		Spinner.Visible = false

	end)

end

--// SET STATE
local function SetState(state)

	Enabled = state

	if Enabled then

		Status.Text = "●  CRAFT MACHINE  •  ON"
		Status.TextColor3 = PURPLE

		Label.Text = "MANIPULATE STOCK  •  ACTIVE"

		Tween(Toggle,.2,{
			BackgroundColor3 = Color3.fromRGB(45,29,70)
		})

		Tween(Knob,.3,{
			Position = UDim2.new(1,-25,0,4),
			BackgroundColor3 = PURPLE
		},Enum.EasingStyle.Back)

	else

		Status.Text = "●  CRAFT MACHINE  •  OFF"
		Status.TextColor3 = MUTED

		Label.Text = "MANIPULATE STOCK"

		Tween(Toggle,.2,{
			BackgroundColor3 = Color3.fromRGB(29,30,44)
		})

		Tween(Knob,.3,{
			Position = UDim2.fromOffset(4,4),
			BackgroundColor3 = MUTED
		},Enum.EasingStyle.Back)

	end

end

--// TOGGLE
Toggle.MouseButton1Click:Connect(function()

	if Busy then
		return
	end

	Busy = true

	local NewState = not Enabled

	if NewState then

		StartSpinner()

		for _,msg in ipairs(Messages) do

			Status.Text = "●  "..msg

			task.wait(.12)

		end

		SetState(true)

	else

		StartSpinner()

		Status.Text = "●  Disabling Craft Machine..."

		task.wait(.35)

		SetState(false)

	end

	Busy = false

end)

--// DRAGGING
local Dragging = false
local DragStart
local StartPosition

Header.InputBegan:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then

		Dragging = true
		DragStart = input.Position
		StartPosition = Main.Position

		input.Changed:Connect(function()

			if input.UserInputState == Enum.UserInputState.End then
				Dragging = false
			end

		end)

	end

end)

UIS.InputChanged:Connect(function(input)

	if not Dragging then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseMovement
	or input.UserInputType == Enum.UserInputType.Touch then

		local Delta = input.Position - DragStart

		Main.Position = UDim2.new(
			StartPosition.X.Scale,
			StartPosition.X.Offset + Delta.X,
			StartPosition.Y.Scale,
			StartPosition.Y.Offset + Delta.Y
		)

	end

end)

