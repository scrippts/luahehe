--========================================================
-- MACHINE ANIMATION
--========================================================

local AnimationTime = 0

local AnimationConnection

AnimationConnection = RunService.RenderStepped:Connect(function(dt)

	if not Loading.Parent then
		AnimationConnection:Disconnect()
		return
	end

	AnimationTime += dt

	Ring1.Rotation = AnimationTime * 35
	Ring2.Rotation = -AnimationTime * 55

	local Pulse =
		(math.sin(AnimationTime * 2.5) + 1) / 2

	Core.Size = UDim2.fromScale(
		0.50 + Pulse * 0.035,
		0.50 + Pulse * 0.035
	)

	MachineGlow.Size = UDim2.fromScale(
		0.28 + Pulse * 0.07,
		0.28 + Pulse * 0.07
	)

	MachineGlow.BackgroundTransparency =
		0.955 - Pulse * 0.025

	Brain.Size = UDim2.fromScale(
		0.61 + Pulse * 0.045,
		0.61 + Pulse * 0.045
	)

	-- orbit
	for i, Dot in ipairs(OrbitDots) do

		local Angle =
			AnimationTime * 0.8
			+ (math.pi * 2 / #OrbitDots) * i

		local Radius = 0.17

		Dot.Position = UDim2.fromScale(
			0.5 + math.cos(Angle) * Radius,
			0.42 + math.sin(Angle) * Radius
		)

		local DotPulse =
			(math.sin(AnimationTime * 3 + i) + 1) / 2

		Dot.BackgroundTransparency =
			0.15 + DotPulse * 0.5
	end

	-- shimmer
	local ShineX =
		((AnimationTime * 0.65) % 1.3) - 0.15

	Energy.Position =
		UDim2.fromScale(ShineX, -0.5)
end)

--========================================================
-- REALISTIC PROGRESS
--========================================================

local CurrentProgress = 0

local function SmoothProgress(Target, Duration)

	Target = math.clamp(Target, 0, 100)

	local Start = CurrentProgress
	local Elapsed = 0

	while Elapsed < Duration do

		if not Loading.Parent then
			return
		end

		local dt = RunService.RenderStepped:Wait()
		Elapsed += dt

		local Alpha =
			math.clamp(Elapsed / Duration, 0, 1)

		local Smooth =
			1 - (1 - Alpha)^3

		CurrentProgress =
			Start + (Target - Start) * Smooth

		Progress.Size =
			UDim2.fromScale(
				CurrentProgress / 100,
				1
			)

		Percent.Text =
			math.floor(CurrentProgress + 0.5) .. "%"
	end

	CurrentProgress = Target

	Progress.Size =
		UDim2.fromScale(Target / 100, 1)

	Percent.Text = Target .. "%"
end

--========================================================
-- REALISTIC LOADING SEQUENCE
--========================================================

task.spawn(function()

	--====================================================
	-- STAGE 1 — INITIAL BOOT
	--====================================================

	Status.Text = "Starting RNG Machine..."
	SmoothProgress(4, 1.4)

	Status.Text = "Loading core interface..."
	SmoothProgress(9, 1.1)

	Status.Text = "Checking machine configuration..."
	SmoothProgress(15, 1.6)

	--====================================================
	-- STAGE 2 — SYSTEM LOAD
	--====================================================

	Status.Text = "Loading Brainrot modules..."

	for i = 16, 25 do

		SmoothProgress(
			i,
			math.random(35, 75) / 100
		)

		if math.random() < 0.25 then
			task.wait(math.random(15, 35) / 100)
		end
	end

	Status.Text = "Synchronizing RNG data..."

	for i = 26, 39 do

		SmoothProgress(
			i,
			math.random(40, 90) / 100
		)

		if math.random() < 0.20 then
			task.wait(math.random(15, 30) / 100)
		end
	end

	--====================================================
	-- STAGE 3 — CALIBRATION
	--====================================================

	Status.Text = "Calibrating RNG machine..."

	for i = 40, 55 do

		SmoothProgress(
			i,
			math.random(55, 105) / 100
		)

		if math.random() < 0.30 then
			task.wait(math.random(20, 45) / 100)
		end
	end

	Status.Text = "Verifying machine systems..."

	for i = 56, 68 do

		SmoothProgress(
			i,
			math.random(60, 115) / 100
		)

		if math.random() < 0.35 then
			task.wait(math.random(20, 50) / 100)
		end
	end

	--====================================================
	-- STAGE 4 — SLOWER
	--====================================================

	Status.Text = "Charging RNG reactor..."

	for i = 69, 78 do

		SmoothProgress(
			i,
			math.random(75, 135) / 100
		)

		if math.random() < 0.40 then
			task.wait(math.random(25, 55) / 100)
		end
	end

	Status.Text = "Optimizing Brainrot systems..."

	for i = 79, 84 do

		SmoothProgress(
			i,
			math.random(100, 170) / 100
		)

		if math.random() < 0.45 then
			task.wait(math.random(30, 65) / 100)
		end
	end

	--====================================================
	-- FINAL PREPARATION
	--====================================================

	Status.Text = "Preparing final machine sequence..."

	SmoothProgress(85, 1.8)
	SmoothProgress(86, 1.5)

	task.wait(0.7)

	SmoothProgress(87, 2.0)

	Status.Text = "Verifying Brainrot configuration..."

	task.wait(1.0)

	SmoothProgress(88, 2.2)

	Status.Text = "Finalizing Brainrot systems"

	task.wait(1.3)

	SmoothProgress(89, 2.5)

	--====================================================
	-- 89% HOLD
	--====================================================

	local Finalizing = true
	local DotCount = 0
	local LastDotUpdate = 0

	local HoldConnection

	HoldConnection = RunService.RenderStepped:Connect(function(dt)

		if not Finalizing then
			return
		end

		LastDotUpdate += dt

		if LastDotUpdate >= 0.5 then

			LastDotUpdate = 0

			DotCount += 1

			if DotCount > 3 then
				DotCount = 0
			end

			Status.Text =
				"Finalizing Brainrot systems"
				.. string.rep(".", DotCount)
		end
	end)

	-- Five minute silent hold.
	-- No countdown displayed.
	task.wait(STUCK_TIME)

	Finalizing = false

	if HoldConnection then
		HoldConnection:Disconnect()
	end

	--====================================================
	-- FINALIZATION
	--====================================================

	Status.Text = "Applying final configuration..."

	SmoothProgress(92, 2.0)

	task.wait(0.5)

	Status.Text = "Activating Brainrot systems..."

	SmoothProgress(95, 2.2)

	task.wait(0.5)

	Status.Text = "Starting RNG Machine..."

	SmoothProgress(98, 1.8)

	task.wait(0.5)

	Status.Text = "🧠 RNG Machine Ready"

	SmoothProgress(100, 1.5)

	task.wait(0.8)

	--====================================================
	-- FADE OUT
	--====================================================

	for _, Object in ipairs(Loading:GetDescendants()) do

		if Object:IsA("TextLabel") then

			TweenService:Create(
				Object,
				TweenInfo.new(
					0.8,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.Out
				),
				{
					TextTransparency = 1
				}
			):Play()

		elseif Object:IsA("Frame") then

			TweenService:Create(
				Object,
				TweenInfo.new(
					0.8,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.Out
				),
				{
					BackgroundTransparency = 1
				}
			):Play()

		elseif Object:IsA("UIStroke") then

			TweenService:Create(
				Object,
				TweenInfo.new(0.8),
				{
					Transparency = 1
				}
			):Play()
		end
	end

	TweenService:Create(
		Loading,
		TweenInfo.new(0.9),
		{
			BackgroundTransparency = 1
		}
	):Play()

	task.wait(1)

	Loading:Destroy()
end)

