--========================================================

local function CreateToggle(Text, Icon, Y, Callback)

	local Holder = Instance.new("Frame")
	Holder.BackgroundColor3 = COLORS.Card
	Holder.Position = UDim2.fromScale(0.06, Y)
	Holder.Size = UDim2.fromScale(0.88, 0.105)
	Holder.BorderSizePixel = 0
	Holder.Parent = Main

	local HolderCorner = Instance.new("UICorner")
	HolderCorner.CornerRadius = UDim.new(0, 10)
	HolderCorner.Parent = Holder

	local HolderStroke = Instance.new("UIStroke")
	HolderStroke.Color = Color3.fromRGB(48, 47, 65)
	HolderStroke.Transparency = 0.35
	HolderStroke.Thickness = 1
	HolderStroke.Parent = Holder

	--====================================================
	-- ICON
	--====================================================

	local IconLabel = Instance.new("TextLabel")
	IconLabel.Position = UDim2.fromScale(0.05, 0.1)
	IconLabel.Size = UDim2.fromScale(0.13, 0.8)
	IconLabel.BackgroundTransparency = 1
	IconLabel.Font = Enum.Font.GothamBold
	IconLabel.Text = Icon
	IconLabel.TextScaled = true
	IconLabel.TextColor3 = COLORS.White
	IconLabel.Parent = Holder

	--====================================================
	-- TEXT
	--====================================================

	local Label = Instance.new("TextLabel")
	Label.Position = UDim2.fromScale(0.20, 0)
	Label.Size = UDim2.fromScale(0.55, 1)
	Label.BackgroundTransparency = 1
	Label.Font = Enum.Font.GothamMedium
	Label.Text = Text
	Label.TextScaled = true
	Label.TextColor3 = COLORS.Light
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.Parent = Holder

	--====================================================
	-- TOGGLE
	--====================================================

	local Toggle = Instance.new("TextButton")
	Toggle.AnchorPoint = Vector2.new(1, 0.5)
	Toggle.Position = UDim2.fromScale(0.94, 0.5)
	Toggle.Size = UDim2.fromScale(0.20, 0.38)
	Toggle.BackgroundColor3 = Color3.fromRGB(52, 51, 66)
	Toggle.BorderSizePixel = 0
	Toggle.Text = ""
	Toggle.AutoButtonColor = false
	Toggle.Parent = Holder

	local ToggleCorner = Instance.new("UICorner")
	ToggleCorner.CornerRadius = UDim.new(1, 0)
	ToggleCorner.Parent = Toggle

	--====================================================
	-- KNOB
	--====================================================

	local Knob = Instance.new("Frame")
	Knob.AnchorPoint = Vector2.new(0, 0.5)
	Knob.Position = UDim2.fromScale(0.08, 0.5)
	Knob.Size = UDim2.fromScale(0.34, 0.70)
	Knob.BackgroundColor3 = Color3.fromRGB(190, 190, 205)
	Knob.BorderSizePixel = 0
	Knob.Parent = Toggle

	local KnobCorner = Instance.new("UICorner")
	KnobCorner.CornerRadius = UDim.new(1, 0)
	KnobCorner.Parent = Knob

	local Enabled = false

	local function Update(Value)

		Enabled = Value

		if Enabled then

			TweenService:Create(
				Toggle,
				TweenInfo.new(0.2),
				{
					BackgroundColor3 = COLORS.Green
				}
			):Play()

			TweenService:Create(
				Knob,
				TweenInfo.new(
					0.22,
					Enum.EasingStyle.Back,
					Enum.EasingDirection.Out
				),
				{
					Position = UDim2.fromScale(0.58, 0.5),
					BackgroundColor3 = COLORS.White
				}
			):Play()

			TweenService:Create(
				HolderStroke,
				TweenInfo.new(0.2),
				{
					Color = COLORS.Green,
					Transparency = 0.5
				}
			):Play()

		else

			TweenService:Create(
				Toggle,
				TweenInfo.new(0.2),
				{
					BackgroundColor3 = Color3.fromRGB(52, 51, 66)
				}
			):Play()

			TweenService:Create(
				Knob,
				TweenInfo.new(
					0.22,
					Enum.EasingStyle.Back,
					Enum.EasingDirection.Out
				),
				{
					Position = UDim2.fromScale(0.08, 0.5),
					BackgroundColor3 = Color3.fromRGB(190, 190, 205)
				}
			):Play()

			TweenService:Create(
				HolderStroke,
				TweenInfo.new(0.2),
				{
					Color = Color3.fromRGB(48, 47, 65),
					Transparency = 0.35
				}
			):Play()

		end

		Callback(Enabled)

	end

	Toggle.MouseButton1Click:Connect(function()

		Update(not Enabled)

	end)

	Update(false)

	return Update

end

