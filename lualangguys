	Label.TextScaled = true
	Label.TextColor3 = Color3.fromRGB(225, 225, 235)
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.Parent = Holder

	local Toggle = Instance.new("TextButton")
	Toggle.Name = "Toggle"
	Toggle.AnchorPoint = Vector2.new(1, 0.5)
	Toggle.Position = UDim2.fromScale(1, 0.5)
	Toggle.Size = UDim2.fromScale(0.16, 0.43)
	Toggle.BackgroundColor3 = Color3.fromRGB(48, 48, 60)
	Toggle.BorderSizePixel = 0
	Toggle.Text = ""
	Toggle.AutoButtonColor = false
	Toggle.Parent = Holder

	local ToggleCorner = Instance.new("UICorner")
	ToggleCorner.CornerRadius = UDim.new(1, 0)
	ToggleCorner.Parent = Toggle

	local Knob = Instance.new("Frame")
	Knob.AnchorPoint = Vector2.new(0, 0.5)
	Knob.Position = UDim2.fromScale(0.07, 0.5)
	Knob.Size = UDim2.fromScale(0.30, 0.72)
	Knob.BackgroundColor3 = Color3.fromRGB(190, 190, 200)
	Knob.BorderSizePixel = 0
	Knob.Parent = Toggle

	local KnobCorner = Instance.new("UICorner")
	KnobCorner.CornerRadius = UDim.new(1, 0)
	KnobCorner.Parent = Knob

	local Enabled = false

	local function Update(Value)

		Enabled = Value

		if Enabled then

			TweenService:Create(
				Toggle,
				TweenInfo.new(0.18),
				{
					BackgroundColor3 = Color3.fromRGB(45, 210, 130)
				}
			):Play()

			TweenService:Create(
				Knob,
				TweenInfo.new(
					0.18,
					Enum.EasingStyle.Back,
					Enum.EasingDirection.Out
				),
				{
					Position = UDim2.fromScale(0.63, 0.5),
					BackgroundColor3 = Color3.fromRGB(245, 255, 250)
				}
			):Play()

		else

			TweenService:Create(
				Toggle,
				TweenInfo.new(0.18),
				{
					BackgroundColor3 = Color3.fromRGB(48, 48, 60)
				}
			):Play()

			TweenService:Create(
				Knob,
				TweenInfo.new(
					0.18,
					Enum.EasingStyle.Back,
					Enum.EasingDirection.Out
				),
				{
					Position = UDim2.fromScale(0.07, 0.5),
					BackgroundColor3 = Color3.fromRGB(190, 190, 200)
				}
			):Play()
		end

		Callback(Enabled)
	end

	Toggle.MouseButton1Click:Connect(function()
		Update(not Enabled)
	end)

	Update(false)
end

