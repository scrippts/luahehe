--========================================================
-- ANIMATION
--========================================================

local AnimationTime = 0

local AnimationConnection

AnimationConnection = RunService.RenderStepped:Connect(function(dt)

	if not Loading.Parent then
		AnimationConnection:Disconnect()
		return
	end

	AnimationTime += dt

	Ring1.Rotation = AnimationTime * 40
	Ring2.Rotation = -AnimationTime * 60

	local Pulse = (math.sin(AnimationTime * 2.5) + 1) / 2

	Core.Size = UDim2.fromScale(
		0.50 + Pulse * 0.035,
		0.50 + Pulse * 0.035
	)

	MachineGlow.Size = UDim2.fromScale(
		0.28 + Pulse * 0.07,
		0.28 + Pulse * 0.07
	)

	MachineGlow.BackgroundTransparency =
		0.955 - Pulse * 0.025

	Brain.Size = UDim2.fromScale(
		0.61 + Pulse * 0.045,
		0.61 + Pulse * 0.045
	)

	for i, Dot in ipairs(OrbitDots) do

		local Angle =
			AnimationTime * 0.8
			+ (math.pi * 2 / #OrbitDots) * i

		local Radius = 0.18

		Dot.Position = UDim2.fromScale(
			0.5 + math.cos(Angle) * Radius,
			0.41 + math.sin(Angle) * Radius
		)

		Dot.BackgroundTransparency =
			0.15 + ((math.sin(AnimationTime * 3 + i) + 1) / 2) * 0.5
	end

	local ShineX =
		((AnimationTime * 0.65) % 1.3) - 0.15

	Energy.Position =
		UDim2.fromScale(ShineX, -0.5)
end)

--========================================================
-- PROGRESS FUNCTION
--========================================================

local CurrentProgress = 0

local function SetProgress(Target, Duration)

	local Start = CurrentProgress
	local Elapsed = 0

	while Elapsed < Duration do

		if not Loading.Parent then
			return
		end

		local dt = RunService.RenderStepped:Wait()
		Elapsed += dt

		local Alpha = math.clamp(
			Elapsed / Duration,
			0,
			1
		)

		local Smooth =
			1 - (1 - Alpha)^3

		CurrentProgress =
			Start + (Target - Start) * Smooth

		Progress.Size =
			UDim2.fromScale(
				CurrentProgress / 100,
				1
			)

		Percent.Text =
			math.floor(CurrentProgress + 0.5) .. "%"

	end

	CurrentProgress = Target

	Progress.Size =
		UDim2.fromScale(Target / 100, 1)

	Percent.Text = Target .. "%"
end

