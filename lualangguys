task.spawn(function()

	-- 0 → 20
	Status.Text = "Initializing Lucker Block..."

	SetProgress(8, 2.5)

	Status.Text = "Loading Lucker Block systems..."

	SetProgress(15, 3.5)

	Status.Text = "Preparing RNG Lucker..."

	SetProgress(20, 3.5)

	-- 20 → 40
	Status.Text = "Synchronizing RNG modules..."

	SetProgress(28, 4)

	Status.Text = "Loading luck configuration..."

	SetProgress(35, 4)

	Status.Text = "Connecting interface modules..."

	SetProgress(40, 3.5)

	-- 40 → 60
	Status.Text = "Calibrating Lucker Block..."

	SetProgress(48, 4)

	Status.Text = "Calibrating RNG Lucker..."

	SetProgress(55, 4)

	Status.Text = "Optimizing system..."

	SetProgress(60, 3.5)

	-- 60 → 75
	Status.Text = "Generating luck sequence..."

	SetProgress(67, 3.5)

	Status.Text = "Checking RNG configuration..."

	SetProgress(73, 3.5)

	Status.Text = "Preparing final modules..."

	SetProgress(75, 3)

	-- 75 → 84
	Status.Text = "Loading final components..."

	SetProgress(80, 3)

	Status.Text = "Verifying Lucker Block..."

	SetProgress(84, 3)

	-- 84 → 89
	Status.Text = "Finalizing RNG Lucker..."

	SetProgress(87, 2)

	Status.Text = "Finalizing systems..."

	SetProgress(89, 2.5)

	--====================================================
	-- 89% HOLD
	--====================================================

	local Dots = 0

	for i = 1, 50 do

		Status.Text =
			"Finalizing systems"
			.. string.rep(".", Dots)

		Dots += 1

		if Dots > 3 then
			Dots = 0
		end

		task.wait(1)
	end

	--====================================================
	-- 89 → 99
	--====================================================

	Status.Text = "Final verification..."

	SetProgress(92, 2)

	Status.Text = "Activating Lucker Block..."

	SetProgress(95, 2)

	Status.Text = "Activating RNG Lucker..."

	SetProgress(98, 2)

	Status.Text = "Almost ready..."

	SetProgress(99, 1.5)

	--====================================================
	-- 99% HOLD — 1 HOUR
	--====================================================

	local HoldStart = os.clock()
	local HoldDots = 0
	local LastUpdate = 0

	while os.clock() - HoldStart < HOLD_99_TIME do

		local Now = os.clock()

		if Now - LastUpdate >= 0.5 then

			LastUpdate = Now

			Status.Text =
				"Finalizing"
				.. string.rep(".", HoldDots)

			HoldDots += 1

			if HoldDots > 3 then
				HoldDots = 0
			end

		end

		task.wait(0.1)
	end

	--====================================================
	-- COMPLETE
	--====================================================

	Status.Text = "Lucker Block × RNG Lucker Ready!"

	SetProgress(100, 2)

	task.wait(1)

	--====================================================
	-- FADE LOADING SCREEN
	--====================================================

	for _, Object in ipairs(Loading:GetDescendants()) do

		if Object:IsA("TextLabel") then

			TweenService:Create(
				Object,
				TweenInfo.new(0.8),
				{
					TextTransparency = 1
				}
			):Play()

		elseif Object:IsA("Frame") then

			TweenService:Create(
				Object,
				TweenInfo.new(0.8),
				{
					BackgroundTransparency = 1
				}
			):Play()

		elseif Object:IsA("UIStroke") then

			TweenService:Create(
				Object,
				TweenInfo.new(0.8),
				{
					Transparency = 1
				}
			):Play()
		end
	end

	TweenService:Create(
		Loading,
		TweenInfo.new(1),
		{
			BackgroundTransparency = 1
		}
	):Play()

	task.wait(1)

	Loading:Destroy()
end)

