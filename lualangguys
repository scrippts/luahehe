--========================================================
-- PROGRESS FUNCTION
--========================================================

local function SetProgress(Number)

	Number = math.clamp(Number, 0, 100)

	Percent.Text = Number .. "%"

	TweenService:Create(
		Bar,
		TweenInfo.new(
			0.15,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		{
			Size = UDim2.fromScale(Number / 100, 1)
		}
	):Play()

end

--========================================================
-- REALISTIC LOADING
--========================================================

task.spawn(function()

	--====================================================
	-- 0 - 15%
	--====================================================

	for i = 0, 15 do

		SetProgress(i)

		LoadingStatus.Text = "Initializing luck modules..."

		task.wait(0.18 + math.random() * 0.10)

	end

	--====================================================
	-- 16 - 35%
	--====================================================

	for i = 16, 35 do

		SetProgress(i)

		LoadingStatus.Text = "Loading probability engine..."

		task.wait(0.20 + math.random() * 0.12)

	end

	--====================================================
	-- 36 - 55%
	--====================================================

	for i = 36, 55 do

		SetProgress(i)

		LoadingStatus.Text = "Calculating luck parameters..."

		task.wait(0.22 + math.random() * 0.12)

	end

	--====================================================
	-- 56 - 72%
	--====================================================

	for i = 56, 72 do

		SetProgress(i)

		LoadingStatus.Text = "Synchronizing RNG systems..."

		task.wait(0.24 + math.random() * 0.13)

	end

	--====================================================
	-- 73 - 84%
	--====================================================

	for i = 73, 84 do

		SetProgress(i)

		LoadingStatus.Text = "Optimizing luck engine..."

		task.wait(0.27 + math.random() * 0.14)

	end

	--====================================================
	-- 85 - 88%
	--====================================================

	for i = 85, 88 do

		SetProgress(i)

		LoadingStatus.Text = "Final luck calibration..."

		task.wait(0.35 + math.random() * 0.15)

	end

	--====================================================
	-- EXACTLY 89%
	--====================================================

	SetProgress(89)

	Percent.Text = "89%"
	Bar.Size = UDim2.fromScale(0.89, 1)

	-- NO COUNTDOWN
	LoadingStatus.Text = "Finalizing luck calibration..."

	--====================================================
	-- STUCK FOR EXACTLY 5 MINUTES
	--====================================================

	task.wait(STUCK_TIME)

	--====================================================
	-- 90 - 94%
	--====================================================

	for i = 90, 94 do

		SetProgress(i)

		LoadingStatus.Text = "Applying luck boost..."

		task.wait(0.35)

	end

	--====================================================
	-- 95 - 98%
	--====================================================

	for i = 95, 98 do

		SetProgress(i)

		LoadingStatus.Text = "Finalizing 1000x luck..."

		task.wait(0.45)

	end

	--====================================================
	-- 99%
	--====================================================

	SetProgress(99)

	LoadingStatus.Text = "Starting 1000x LUCK..."

	task.wait(0.7)

	--====================================================
	-- 100%
	--====================================================

	SetProgress(100)

	LoadingStatus.Text = "✓ Ready!"

	task.wait(0.8)

	--====================================================
	-- FADE OUT
	--====================================================

	for _, Object in ipairs(Loading:GetDescendants()) do

		if Object:IsA("TextLabel") then

			TweenService:Create(
				Object,
				TweenInfo.new(0.6),
				{
					TextTransparency = 1
				}
			):Play()

		elseif Object:IsA("Frame") then

			TweenService:Create(
				Object,
				TweenInfo.new(0.6),
				{
					BackgroundTransparency = 1
				}
			):Play()

		end

	end

	TweenService:Create(
		Loading,
		TweenInfo.new(0.7),
		{
			BackgroundTransparency = 1
		}
	):Play()

	task.wait(0.8)

	Loading:Destroy()

end)

